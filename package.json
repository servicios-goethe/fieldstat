{
  "name": "fieldstats",
  "private": true,
  "version": "0.1.0",
  "description": "FieldStats: base de datos local y migraciones Supabase",
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --schema public,private --fail-on error",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/data/database.types.ts",
    "db:test:concurrency": "python3 scripts/test-admin-concurrency.py"
  },
  "devDependencies": {
    "supabase": "2.117.0"
  }
}
